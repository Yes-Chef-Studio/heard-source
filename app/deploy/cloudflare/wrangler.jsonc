// Heard on Cloudflare: one Worker at heard.yeschef-dev.fyi in front of two Containers.
//   App      - the API (Bun, port 3000) and the dashboard (Next.js, port 3001) in one image
//   Renderer - Playwright browsers that turn DOM snapshots into screenshots (never public)
// Deployed by .github/workflows/deploy-cloudflare.yml on every push to main.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "heard.yeschef-dev.fyi", "custom_domain": true }],
  "observability": { "enabled": true },

  "vars": {
    "HEARD_URL": "https://heard.yeschef-dev.fyi",
    "STORAGE_BUCKET": "heard",
    "ALLOWED_SIGNUP_DOMAINS": "yeschef.studio"
  },

  "containers": [
    {
      "class_name": "App",
      "image": "./app.Dockerfile",
      "image_build_context": "../..",
      "image_vars": { "HEARD_URL": "https://heard.yeschef-dev.fyi" },
      "instance_type": "basic",
      // One instance: the API keeps some state (rate limits, background jobs) in memory.
      "max_instances": 1,
      // The database is in AWS us-east-1, so keep the API next to it.
      "constraints": { "regions": ["ENAM"] }
    },
    {
      "class_name": "Renderer",
      "image": "../../apps/renderer/Dockerfile",
      "image_build_context": "../..",
      // Chromium, WebKit and Firefox need the memory.
      "instance_type": "standard-1",
      "max_instances": 2,
      "constraints": { "regions": ["ENAM"] }
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "APP", "class_name": "App" },
      { "name": "RENDERER", "class_name": "Renderer" }
    ]
  },
  "exports": {
    "App": { "type": "durable-object", "storage": "sqlite" },
    "Renderer": { "type": "durable-object", "storage": "sqlite" }
  }
}
