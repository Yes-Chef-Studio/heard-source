# Heard deployment settings, read by docker-compose.heard.yml.
# Copy to deploy/heard.env (gitignored) and fill in. Generate secrets with:
#   openssl rand -base64 48
# Start with: docker compose -f docker-compose.heard.yml --env-file deploy/heard.env up -d --build

# --- Public URLs (put a TLS proxy such as Caddy or Cloudflare in front) ---
BETTER_AUTH_URL=https://api.heard.example.com
CORS_ORIGINS=https://app.heard.example.com
NEXT_PUBLIC_SITE_URL=https://app.heard.example.com
NEXT_PUBLIC_APP_URL=https://app.heard.example.com
NEXT_PUBLIC_SERVER_URL=https://api.heard.example.com

# --- Secrets ---
POSTGRES_PASSWORD=
# Must repeat the password above.
DATABASE_URL=postgresql://heard:CHANGE_ME@postgres:5432/heard
BETTER_AUTH_SECRET=
RENDERER_SECRET=
CAPTURE_SUBMIT_TOKEN_SECRET=

# --- Accounts ---
# Heard sends no email. Self sign-up is off; an admin adds people and sets passwords:
#   docker compose -f docker-compose.heard.yml --env-file deploy/heard.env \
#     exec server bun apps/server/scripts/users.ts add jane@yeschef.studio "Jane Smith"
DISABLE_SIGNUP=true
ALLOWED_SIGNUP_DOMAINS=yeschef.studio
ENABLE_PAYMENTS=false

# --- Storage: Cloudflare R2 (recommended) ---
STORAGE_BUCKET=heard
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Or run SeaweedFS with --profile local-storage. Browsers upload to it directly, so it needs a
# public HTTPS address:
# STORAGE_ENDPOINT=https://files.heard.example.com
# STORAGE_ADDRESSING_STYLE=path

# --- Optional ---
# Leave empty: Heard runs without email. Set both to turn on verification, resets and invites.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
